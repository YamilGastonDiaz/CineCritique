@model CineCritique.Models.Pelicula

@{
    ViewData["Title"] = "Edit";
}

<div class="row g-5 mb-5">
    <h1 class="display-title">
        Pelicula Editar
    </h1>
    <hr />
    <!-- Form -->
    <div class="col-lg-8">
        <form asp-action="Edit" class="form-container ink-stroke rubber-hose-shadow-lg">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="badge-config ink-stroke rubber-hose-shadow mb-4">
                Configuration
            </div>
            <p class="lead text-muted mb-5">
                Edita tu pelicula.
            </p>
            <div class="row g-4">
                <!-- Movie Name -->
                <div class="col-12">
                    <label asp-for="Titulo" class="control-label">
                        <span class="material-symbols-outlined text-danger">edit_note</span>
                        Movie Name
                    </label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>
                <!-- Date -->
                <div class="col-12">
                    <label asp-for="FechaLanzamiento" class="control-label">
                        <span class="material-symbols-outlined text-danger">calendar_month</span>
                        Date
                    </label>
                    <input asp-for="FechaLanzamiento" class="form-control" />
                    <span asp-validation-for="FechaLanzamiento" class="text-danger"></span>
                </div>
                <!-- Minutes -->
                <div class="col-12">
                    <label asp-for="MinutosDuracion" class="control-label">
                        <span class="material-symbols-outlined text-danger">edit_note</span>
                        Minutes duration
                    </label>
                    <input asp-for="MinutosDuracion" class="form-control" />
                    <span asp-validation-for="MinutosDuracion" class="text-danger"></span>
                </div>
                <!-- Synopsis -->
                <div class="col-12">
                    <label asp-for="Sinopsis" class="control-label">
                        <span class="material-symbols-outlined text-danger">edit_note</span>
                        Synopsis
                    </label>
                    <textarea asp-for="Sinopsis" class="form-control" rows="4" cols="50"></textarea>
                    <span asp-validation-for="Sinopsis" class="text-danger"></span>
                </div>
                <!-- Url -->
                <div class="col-12">
                    <label asp-for="PosterUrlPortada" class="control-label">
                        <span class="material-symbols-outlined text-danger">link</span>
                        Front Page URL
                    </label>
                    <input asp-for="PosterUrlPortada" class="form-control" />
                    <span asp-validation-for="PosterUrlPortada" class="text-danger"></span>
                </div>
                <!-- Genere -->
                <div class="col-12">
                    <label asp-for="GeneroId" class="control-label">
                        <span class="material-symbols-outlined fs-2 text-danger">auto_fix_high</span>
                        Genere
                    </label>
                    <select asp-for="GeneroId" class="form-control" asp-items="ViewBag.GeneroId"></select>
                    <span asp-validation-for="GeneroId" class="text-danger"></span>
                </div>
                <!-- Plataform -->
                <div class="col-12">
                    <label asp-for="PlataformaId" class="control-label">
                        <span class="material-symbols-outlined fs-2 text-danger">rocket_launch</span>
                        Plataform
                    </label>
                    <select asp-for="PlataformaId" class="form-control" asp-items="ViewBag.PlataformaId"></select>
                    <span asp-validation-for="PlataformaId" class="text-danger"></span>
                </div>
                <!-- Submit -->
                <div class="col-12 mt-5">
                    <button class="submit-btn ink-stroke rubber-hose-shadow" type="submit" value="Create">
                        EDIT MOVIE
                        <span class="material-symbols-outlined fs-2">movie_filter</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <div class="col-4 m-4">
        <a asp-action="Index" class="btn btn-light ink-stroke btn-toon rubber-hose-shadow px-4 py-2">Back to List</a>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
