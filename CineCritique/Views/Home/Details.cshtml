﻿@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> SignInManager
@inject UserManager<Usuario> UserManager
@model Pelicula

@{
    ViewData["Title"] = "Detalle de Pelicula";
    int horas = Model.MinutosDuracion / 60;
    int minutos = Model.MinutosDuracion % 60;
}

<div class="col-lg-12">
    <div class="mb-3">
        <span class="badge bg-secondary-inkwell text-black px-3 py-2 border border-dark border-2" style="box-shadow: 4px 4px 0px 0px #000; border-radius: 0;">DETAILS</span>
    </div>
    <h1 class="display-1 fw-bold text-uppercase fst-italic tracking-tighter mb-4" style="line-height: 0.9;">@Model.Titulo</h1>
</div>
<div class="mt-4 border-bottom border-dark border-4" style="box-shadow: 2px 2px 0 0 #000;"></div>
<!-- Content Grid -->
<div class="container my-5 py-5">
    <div class="row g-5">
        <!-- Sidebar -->
        <aside class="col-lg-4 order-lg-1">
            <div class="bg-white inkwell-border-heavy inner-frame mb-5">
                <img alt="@Model.Titulo" class="img-fluid grayscale w-100" src="@Model.PosterUrlPortada" />
            </div>
            <div class="p-4 bg-cream inkwell-border">
                <h5 class="fw-bold text-uppercase fst-italic border-bottom border-dark pb-2 mb-3">TECHNICAL REEL</h5>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <span class="text-uppercase small fw-bold opacity-75">Duration</span>
                    <span class="fw-medium">@horas h @minutos m</span>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <span class="text-uppercase small fw-bold opacity-75">Release</span>
                    <span class="fw-medium">@Model.FechaLanzamiento.Year</span>
                </div>
                <div class="mb-2 d-flex justify-content-between align-items-center">
                    <span class="text-uppercase small fw-bold opacity-75">Genre</span>
                    <span class="fw-medium">@Model.Genero.Descripcion</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-uppercase small fw-bold opacity-75">Platform</span>
                    <div class="d-flex align-items-center gap-1">
                        <span class="material-symbols-outlined text-danger">tv</span>
                        <span class="fw-medium">@Model.Plataforma.Nombre</span>
                    </div>
                </div>
            </div>
        </aside>
        <!-- Main Content -->
        <div class="col-lg-8 order-lg-2">
            <!-- Synopsis -->
            <div class="mb-5">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <h2 class="text-uppercase fw-bold fst-italic m-0 h1">The Synopsis</h2>
                    <div class="flex-grow-1 border-top border-dark border-3"></div>
                </div>
                <p class="fs-4 fst-italic" style="line-height: 1.6;">
                    <span class="material-symbols-outlined text-black" style="font-variation-settings: 'FILL';">star</span>
                </p>
                <p class="fs-4" style="line-height: 1.6;">
                    @Model.Sinopsis
                </p>
            </div>
            <!-- Review Section -->
            <div class="d-flex flex-column flex-sm-row gap-3 mb-4 w-100">
                <button @(ViewBag.UserReview ? "disabled" : "") class="btn btn-vintage flex-fill" data-bs-toggle="modal" data-bs-target="#createReviewModal">
                    CREATE REVIEW
                    <span class="material-symbols-outlined fs-6 align-middle ms-1">arrow_forward</span>
                </button>
                <button onclick="cargarLlm('Resumen', '@Model.Titulo')" class="btn btn-vintage flex-fill">
                    RESUMEN IA
                    <span class="material-symbols-outlined fs-6 align-middle ms-1">arrow_forward</span>
                </button>
                <button onclick="cargarLlm('Spoiler', '@Model.Titulo')" class="btn btn-vintage flex-fill">
                    SPOILER ALERT
                    <span class="material-symbols-outlined fs-6 align-middle ms-1">arrow_forward</span>
                </button>
            </div>

            <!-- Messagge exito o error -->
            @if (TempData["ReviewExiste"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>@TempData["ReviewExiste"]</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Review Title -->
            <div>
                <h5 class="fw-bold fst-italic mb-4 d-flex align-items-center gap-2">
                    <span class="material-symbols-outlined">forum</span> REVIEWS
                </h5>
            </div>
            <!-- Recent Reviews -->
            @foreach (var item in Model.ListaReviews)
            {
                <div class="mb-3">                    
                    <div class="p-4 bg-white inkwell-border d-flex gap-4">
                        <img alt="@item.Usuario.Nombre" class="rounded-circle me-3" height="40"
                             src="@(string.IsNullOrEmpty(item.Usuario.ImagenUrlPerfil) ? "/images/default-avatar.png" : item.Usuario.ImagenUrlPerfil)"
                             onerror="this.src='/images/default-avatar.png'" width="40" />
                        <div>
                            <div class="d-flex justify-content-between mb-0">
                                <h6 class="fw-bold me-3">@string.Concat(item.Usuario.Nombre, " ", item.Usuario.Apellido)</h6>
                                <span class="small fst-italic opacity-50">@item.FechaReview.ToShortDateString()</span>
                            </div>
                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <span class="material-symbols-outlined star-filled">star</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined star-empty">grade</span>
                                    }
                                }
                            </div>
                            <p class="mb-3">@item.Comentario</p>

                            @if (SignInManager.IsSignedIn(User))
                            {
                                @if (UserManager.IsInRoleAsync(await UserManager.GetUserAsync(User), "Admin").Result)
                                {
                                    <div>
                                        <a asp-controller="Review" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-dark">
                                            Editar
                                        </a>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@{
    var review = new ReviewCreateViewModel
    {
        PeliculaId = Model.Id,
        PeliculaTitulo = Model.Titulo
    };
}


<partial name="~/Views/Review/_CreateReview.cshtml" model="review" />

@* Modal LLM *@
@{
    var llmViewModel = new ModalLlmViewModel
    {
        Tipo = "",
        Pelicula = Model.Titulo,
        SpoilerResumen = ""
    };
}

<partial name="~/Views/Home/_ModalLlm.cshtml" model="llmViewModel" />

@section Scripts {
    <script>
        function cargarLlm(tipo, titulo) {
            // Mostrar el modal
            const modal = new bootstrap.Modal(document.getElementById('llmModal'));

            // Actualizar el título del modal
            document.getElementById('modalTipoTexto').textContent = tipo;
            document.getElementById('modalPeliculaTexto').textContent = titulo;

            // Mostrar spinner y ocultar contenido
            document.getElementById('llmModalLoading').style.display = 'block';
            document.getElementById('llmModalContent').style.display = 'none';

            modal.show();

            // Determinar la URL según el tipo
            const url = tipo === 'Spoiler'
                ? '@Url.Action("Spoiler", "Home")?titulo=' + encodeURIComponent(titulo)
                : '@Url.Action("Resumen", "Home")?titulo=' + encodeURIComponent(titulo);

            // Hacer la llamada AJAX
            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('llmModalContent').innerHTML = '<p>' + data.data + '</p>';
                    } else {
                        document.getElementById('llmModalContent').innerHTML =
                            '<div class="alert alert-danger">Error: ' + data.message + '</div>';
                    }
                })
                .catch(error => {
                    document.getElementById('llmModalContent').innerHTML =
                        '<div class="alert alert-danger">Error al cargar la información: ' + error.message + '</div>';
                })
                .finally(() => {
                    // Ocultar spinner y mostrar contenido
                    document.getElementById('llmModalLoading').style.display = 'none';
                    document.getElementById('llmModalContent').style.display = 'block';
                });
        }
    </script>
}