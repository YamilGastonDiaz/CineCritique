@model List<Pelicula>

@{
    ViewData["Title"] = "Home Page";

    var paginaActual = ViewBag.PaginaActual ?? 1;
    var totalPaginas = ViewBag.totalPaginas ?? 1;
    var totalPeliculas = ViewBag.totalPeliculas ?? 0;
    var busqueda = ViewBag.TxtBusqueda ?? "";
    var generoId = ViewBag.GeneroId ?? 0;
    var plataformaId = ViewBag.PlataformaId ?? 0;
}

<div class="py-5 mt-4">
    <!-- Header & Filters Section -->
    <section class="mb-5">
        <div class="row align-items-end g-4">
            <div class="col-lg-12">
                <span class="badge badge-vintage mb-2">The Archive</span>
                <h2 class="display-5 fw-bold mb-3">Listado de Películas</h2>
            </div>
            <form method="get" class="row">
                <div class="col-lg-6">
                    <div class="input-group">
                        <button type="submit" class="input-group-text">Buscar</button>
                        <input name="txtBusqueda" value="@busqueda" class="form-control form-control-lg" placeholder="Buscar películas..." type="text" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex flex-wrap gap-3 justify-content-lg-end">
                        <div class="flex-grow-1 flex-lg-grow-0">                           
                            <select name="generoId" class="form-control" asp-items="@ViewBag.GeneroId" onchange="this.form.submit()"></select>
                        </div>
                        <div class="flex-grow-1 flex-lg-grow-0">
                            <select name="plataformaId" class="form-control" asp-items="@ViewBag.PlataformaId" onchange="this.form.submit()"></select>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="mt-4 border-bottom border-dark border-4" style="box-shadow: 2px 2px 0 0 #000;"></div>
    </section>
    <!-- Movie Grid -->
    <section class="row g-4">
        <!-- Movie Card 1 -->
        @foreach (var pelicula in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 movie-card vintage-border vintage-card-hover">
                    <div class="position-relative border-bottom border-dark border-2 overflow-hidden">
                        <img alt="@pelicula.Titulo" class="card-img-top" src="@pelicula.PosterUrlPortada" />
                        <div class="year-tag" style="transform: rotate(-2deg);">@pelicula.FechaLanzamiento.Year</div>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h3 class="h5 fw-bold mb-0">@pelicula.Titulo</h3>
                        </div>
                        <div class="d-flex gap-2 mb-4">
                            <span class="material-symbols-outlined text-black" style="font-variation-settings: 'FILL';">star</span>
                        </div>
                        <a asp-action="Details" asp-route-id="@pelicula.Id" class="btn btn-vintage w-100 mt-auto d-flex align-items-center justify-content-center gap-2">
                            VIEW DETAILS
                            <span class="material-symbols-outlined fs-6">arrow_forward</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </section>
    <!-- Pagination -->
    @if (totalPaginas > 1)
    {
        <nav class="mt-5 mb-5 pt-4 d-flex justify-content-center">
            <ul class="pagination pagination-lg">
                <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                    <a asp-action="Index" class="page-link" asp-route-pagina="@(paginaActual - 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoId">Previous</a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">
                        <a asp-action="Index" asp-route-pagina="@i" class="page-link" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoId">@i</a>
                    </li>
                }

                <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                    <a asp-action="Index" class="page-link" asp-route-pagina="@(paginaActual + 1)" asp-route-txtBusqueda="@busqueda" asp-route-generoId="@generoId">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>
